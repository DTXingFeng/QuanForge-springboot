[Unit]
Description=QuanForge v4.8.1 trend-rule paper trader TP5 twin
After=network-online.target quanforge.service
Wants=network-online.target

[Service]
Type=simple
User=xingfeng
Environment=TP_R=5
Environment=SIZING=eq
Environment=PAPER_DB=/mnt/nvme/quanforge/data/paper_trendrule_tp5.db
ExecStart=/usr/bin/python3 /mnt/nvme/quanforge/tools/paper_trendrule.py
Restart=always
RestartSec=15
StandardOutput=append:/mnt/nvme/quanforge/logs/paper5.log
StandardError=append:/mnt/nvme/quanforge/logs/paper5.log

[Install]
WantedBy=multi-user.target
